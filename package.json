{
  "name": "desktop-fly-pet",
  "productName": "果蝇乐园",
  "version": "0.3.6",
  "description": "Desktop fruit flies that land on icons, flee the cursor, eat, and can be swatted",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "start:annoy": "node scripts/set-flavor.mjs annoy && electron . && node scripts/set-flavor.mjs breed",
    "dist": "node scripts/build.mjs",
    "dist:annoy": "node scripts/build.mjs --flavor annoy",
    "dist:all": "node scripts/build.mjs --flavor breed,annoy",
    "dist:portable": "node scripts/build.mjs --targets portable",
    "dist:portable:annoy": "node scripts/build.mjs --flavor annoy --targets portable",
    "dist:nsis": "node scripts/build.mjs --targets nsis"
  },
  "license": "MIT",
  "author": "desktop-fly-pet",
  "dependencies": {
    "koffi": "^3.3.0"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.desktopfly.pet",
    "productName": "果蝇乐园",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.mjs",
      "preload-panel.mjs",
      "package.json",
      "flavor.json",
      "renderer/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/icon.png",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "果蝇乐园",
      "include": "build/installer.nsh",
      "artifactName": "fly-paradise-setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "fly-paradise-portable-${version}.${ext}",
      "requestExecutionLevel": "user",
      "unpackDirName": "fly-paradise-portable"
    }
  }
}
